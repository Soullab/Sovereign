{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyRead": ["~/.config/gh", "~/.aws", "~/.ssh", "~/.claude.json", "~/.docker", "~/.netrc"]
    },
    "network": {
      "allowedDomains": ["registry.npmjs.org", "api.anthropic.com"]
    }
  },
  "permissions": {
    "deny": [
      "Read(~/.config/gh/**)", "Read(~/.aws/**)", "Read(~/.ssh/**)", "Read(~/.claude.json)", "Read(~/.docker/**)", "Read(~/.netrc)",
      "Read(**/.env)", "Read(**/.env.local)", "Read(**/.env.docker)", "Read(**/.env.production)", "Read(**/.env.development)", "Read(**/.env.staging)",
      "Edit(.claude/**)",
      "Bash(git push:*)", "Bash(git commit:*)", "Bash(ssh:*)", "Bash(gh:*)", "Bash(docker:*)", "Bash(psql:*)",
      "WebFetch", "WebSearch"
    ]
  }
}
