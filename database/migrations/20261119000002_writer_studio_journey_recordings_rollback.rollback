-- Rollback for writer_studio_journey_recordings.
--
-- ⭐ THE SUPPORTED ROLLBACK IS APP-ONLY: roll the image back and leave this table. Nothing else reads it.
-- ⛔ This schema rollback deletes recordings writers chose to send, so it REFUSES while any exist.
BEGIN;
SET LOCAL lock_timeout = '5s';
DO $$ BEGIN
  IF to_regclass('public.writer_studio_journey_recordings') IS NOT NULL THEN
    LOCK TABLE public.writer_studio_journey_recordings IN ACCESS EXCLUSIVE MODE;
  END IF;
END $$;
DO $$
DECLARE carried bigint;
BEGIN
  IF to_regclass('writer_studio_journey_recordings') IS NOT NULL THEN
    SELECT count(*) INTO carried FROM writer_studio_journey_recordings;
    IF carried > 0 THEN
      RAISE EXCEPTION 'refusing destructive rollback: % recording(s) exist. Use the app-only rollback (image).', carried;
    END IF;
  END IF;
END $$;
DROP INDEX IF EXISTS writer_studio_journey_recordings_expiry_idx;
DROP INDEX IF EXISTS writer_studio_journey_recordings_member_idx;
DROP TABLE IF EXISTS writer_studio_journey_recordings;
DO $$ BEGIN
  IF to_regclass('public.schema_migrations') IS NOT NULL THEN
    DELETE FROM public.schema_migrations WHERE filename = '20261119000002_writer_studio_journey_recordings.sql';
  END IF;
END $$;
COMMIT;
